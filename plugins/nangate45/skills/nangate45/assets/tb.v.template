`timescale 1ns/1ps
module @TOP@_tb;
    reg clk = 0;
    reg rst_n = 1;
    reg [3:0] in_data = 0;
    wire [3:0] out_data;
    integer i;
    @TOP@ uut (.clk(clk), .rst_n(rst_n), .in_data(in_data), .out_data(out_data));
    always #5 clk = ~clk;
    initial begin
        $dumpfile("../dump/@TOP@.vcd");
        $dumpvars(0, @TOP@_tb);
        #1 rst_n = 0;
        #1;
        if (out_data !== 0) $fatal(1, "Reset failed");
        @(negedge clk);
        rst_n = 1;
        for (i = 0; i < 16; i = i + 1) begin
            in_data = i;
            @(posedge clk); #1;
            if (out_data !== ((i + 1) & 15)) $fatal(1, "Mismatch for input %0d", i);
            @(negedge clk);
        end
        rst_n = 0;
        #1;
        if (out_data !== 0) $fatal(1, "Asynchronous reset failed");
        $display("PASS: all 16 inputs and asynchronous reset");
        $finish;
    end
endmodule
